const fallbackContent = "<div class=\"page-shell\">\n      <header class=\"site-header\" data-mobile-nav>\n        <a class=\"brand\" href=\"/index.html\" aria-label=\"Ir para a home\">\n          <img\n            class=\"brand__logo\"\n            src=\"/assets/images/pisom-header-logo.svg\"\n            alt=\"Logo Pisom Odontologia\"\n            width=\"128\"\n            height=\"96\"\n          />\n        </a>\n\n        <button\n          class=\"site-header__toggle\"\n          type=\"button\"\n          aria-expanded=\"false\"\n          aria-controls=\"site-header-panel\"\n          aria-label=\"Abrir menu\"\n        >\n          <span></span>\n          <span></span>\n          <span></span>\n        </button>\n\n        <div class=\"site-header__panel\" id=\"site-header-panel\">\n          <nav class=\"site-nav\" aria-label=\"Navegação principal\">\n            <a href=\"/paginas/lentes-em-resina.html\">Lentes em Resina</a>\n            <a href=\"/paginas/lentes-em-porcelana.html\">Lentes Premium</a>\n            <a href=\"/paginas/botox.html\">Botox</a>\n            <a href=\"/paginas/preenchimento-labial.html\">Preenchimento Labial</a>\n            <a href=\"/paginas/gengivoplastia.html\">Gengivoplastia</a>\n          </nav>\n\n          <a class=\"button button--ghost site-header__cta\" data-whatsapp-link href=\"#\">\n            Agendar avaliação\n          </a>\n        </div>\n      </header>\n\n      <main>\n        <section class=\"service-hero section\">\n          <div class=\"service-hero__copy\">\n            <p class=\"eyebrow\">Página dedicada</p>\n            <h1>Preenchimento labial com contorno elegante e proporção natural.</h1>\n            <p class=\"hero__lead\">\n              Uma página focada para quem busca lábios mais harmônicos, com\n              volume bem indicado e acabamento compatível com o restante do rosto.\n            </p>\n            <div class=\"hero__actions\">\n              <a href=\"#\" class=\"button\" data-whatsapp-link>Agendar avaliação</a>\n            </div>\n            <div class=\"hero__tags\">\n              <span class=\"tag\">Contorno e hidratação</span>\n              <span class=\"tag\">Volume personalizado</span>\n              <span class=\"tag\">Resultado natural</span>\n            </div>\n          </div>\n\n          <div class=\"service-hero__card\">\n            <div class=\"hero-card service-photo-card\">\n              <img\n                src=\"../assets/images/real/preenchimento-labial-caso.jpg\"\n                alt=\"Caso de preenchimento labial com antes e depois\"\n                width=\"1080\"\n                height=\"1364\"\n              />\n            </div>\n          </div>\n        </section>\n\n        <section id=\"tratamentos-preenchimento-labial\" class=\"section treatments-showcase treatments-showcase--preenchimento-labial\" data-treatment-carousel=\"preenchimento-labial\">\n          <div class=\"section-heading\">\n            <p class=\"eyebrow\">Tratamentos</p>\n            <h2 class=\"section-heading__title--wide\">Tratamentos estéticos pensados para transformar sorrisos e harmonizar resultados.</h2>\n            <p>\n              Conheça os procedimentos da Dra. Vitória Passos e veja como cada\n              detalhe pode valorizar o seu sorriso com naturalidade.\n            </p>\n          </div>\n\n          <div class=\"transformations-marquee transformations-marquee--preenchimento-labial\" aria-label=\"Galeria de transformações de Preenchimento Labial\">\n            <div class=\"transformations-marquee__track\">\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/preenchimento-labial.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/preenchimento-labial-caso.jpg\" alt=\"Caso de preenchimento labial com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Preenchimento Labial</strong>\n                  <span>Antes e depois com contorno, equilíbrio e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-1.png\" alt=\"Caso de botox com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Suavização das linhas com resultado leve e expressão preservada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-1.jpg\" alt=\"Caso de lentes em resina com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes em Resina</strong>\n                  <span>Transformação do sorriso com brilho, forma e naturalidade.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-2.jpg\" alt=\"Outro caso de lentes em resina com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong class=\"transformation-card__title--long\">Lentes em Resina + Gengivoplastia</strong>\n                  <span>Lentes em resina e gengivoplastia para mais simetria e um sorriso sofisticado.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-porcelana.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-premium.jpg\" alt=\"Caso de lentes premium com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes Premium</strong>\n                  <span>Transformação premium do sorriso com estética clara, brilho e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/gengivoplastia.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/gengivoplastia-caso.jpg\" alt=\"Caso de gengivoplastia com antes, procedimento e resultado\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Gengivoplastia</strong>\n                  <span>Contorno gengival mais harmônico para destacar o sorriso.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-2.png\" alt=\"Outro caso de botox com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Mais leveza na testa e leitura facial mais descansada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/preenchimento-labial.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/preenchimento-labial-caso.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Preenchimento Labial</strong>\n                  <span>Antes e depois com contorno, equilíbrio e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-1.png\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Suavização das linhas com resultado leve e expressão preservada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-1.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes em Resina</strong>\n                  <span>Transformação do sorriso com brilho, forma e naturalidade.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-2.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong class=\"transformation-card__title--long\">Lentes em Resina + Gengivoplastia</strong>\n                  <span>Lentes em resina e gengivoplastia para mais simetria e um sorriso sofisticado.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-porcelana.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-premium.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes Premium</strong>\n                  <span>Transformação premium do sorriso com estética clara, brilho e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/gengivoplastia.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/gengivoplastia-caso.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Gengivoplastia</strong>\n                  <span>Contorno gengival mais harmônico para destacar o sorriso.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-2.png\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Mais leveza na testa e leitura facial mais descansada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n            </div>\n          </div>\n\n        </section>\n\n        <section class=\"what-is section what-is--cards-only service-style-cards\">\n          <div class=\"container\">\n            <div class=\"what-is__grid\">\n              <div class=\"what-is__cards reveal reveal--right\">\n                <div class=\"info-card\">\n                  <div class=\"info-card__icon\">Tempo</div>\n                  <h3>30 a 45 minutos</h3>\n                  <p>Procedimento realizado em consultório, sem internação e com orientações simples para o retorno à rotina.</p>\n                </div>\n                <div class=\"info-card\">\n                  <div class=\"info-card__icon\">Resultado</div>\n                  <h3>Resultado visível na hora</h3>\n                  <p>O volume e o contorno já aparecem após a aplicação, com acabamento mais estável depois da acomodação inicial.</p>\n                </div>\n                <div class=\"info-card\">\n                  <div class=\"info-card__icon\">Duração</div>\n                  <h3>Dura em média 8 a 12 meses</h3>\n                  <p>A duração varia conforme metabolismo, produto utilizado, rotina e resposta individual de cada paciente.</p>\n                </div>\n                <div class=\"info-card\">\n                  <div class=\"info-card__icon\">Segurança</div>\n                  <h3>Planejamento individual</h3>\n                  <p>A aplicação considera anatomia, proporção facial e indicação personalizada por profissional com CRO ativo.</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        <section class=\"section\">\n          <div class=\"section-heading\">\n            <p class=\"eyebrow\">Perguntas Frequentes</p>\n            <h2>Dúvidas comuns de quem quer preenchimento labial com equilíbrio e naturalidade.</h2>\n          </div>\n\n          <div class=\"faq-list faq-list--columns\">\n            <details>\n              <summary>O preenchimento labial sempre aumenta muito os lábios?</summary>\n              <p>\n                Não. O procedimento pode ser feito de forma sutil, com foco em\n                contorno, hidratação, simetria e proporção.\n              </p>\n            </details>\n\n            <details>\n              <summary>O resultado do preenchimento labial é imediato?</summary>\n              <p>\n                O volume já pode ser percebido logo após o procedimento, mas o\n                resultado final fica mais fiel depois do período inicial de adaptação.\n              </p>\n            </details>\n\n            <details>\n              <summary>Quanto tempo dura o preenchimento labial?</summary>\n              <p>\n                A duração varia conforme metabolismo, produto e rotina da pessoa,\n                exigindo manutenção periódica em alguns casos.\n              </p>\n            </details>\n\n            <details>\n              <summary>É possível corrigir assimetria labial com preenchimento?</summary>\n              <p>\n                Sim. O preenchimento pode ajudar a equilibrar contornos e volumes,\n                sempre respeitando a anatomia natural dos lábios.\n              </p>\n            </details>\n\n            <details>\n              <summary>Preenchimento labial pode focar mais em contorno do que em volume?</summary>\n              <p>\n                Sim. Nem todo tratamento busca aumento evidente; muitas vezes o\n                objetivo principal é definir contorno e melhorar a proporção.\n              </p>\n            </details>\n\n            <details>\n              <summary>Os lábios podem continuar com aparência natural?</summary>\n              <p>\n                Sim. Quando o planejamento respeita o formato do rosto e a anatomia\n                labial, o resultado tende a ficar delicado e coerente.\n              </p>\n            </details>\n\n            <details>\n              <summary>Quem tem lábios finos pode buscar um resultado discreto?</summary>\n              <p>\n                Pode. O procedimento pode ser conduzido com suavidade, valorizando\n                hidratação, desenho e equilíbrio sem exagerar no volume.\n              </p>\n            </details>\n\n            <details>\n              <summary>Preenchimento labial combina com lentes em resina ou botox?</summary>\n              <p>\n                Sim. Em alguns casos, ele complementa tanto o sorriso quanto a\n                leitura facial, deixando o conjunto mais harmônico.\n              </p>\n            </details>\n          </div>\n        </section>\n\n      </main>\n\n      <footer class=\"site-footer site-footer--rich\">\n        <div class=\"site-footer__surface\">\n          <div class=\"site-footer__top\">\n            <div class=\"site-footer__intro\">\n              <img\n                class=\"site-footer__logo\"\n                src=\"/assets/images/pison-odontologia-branco-sem-fundo.svg\"\n                alt=\"Logo Pisom Odontologia\"\n                width=\"180\"\n                height=\"120\"\n              />\n              <p>\n                Na Pisom Odontologia, cada avaliação é pensada com cuidado,\n                clareza e foco em resultados estéticos naturais.\n              </p>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Institucional</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/index.html\">Home</a>\n                <a href=\"/index.html#sobre\">Sobre</a>\n                <a href=\"/index.html#duvidas\">Dúvidas</a>\n                <a href=\"/politica-de-privacidade.html\">Política de Privacidade</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Tratamentos</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/paginas/lentes-em-resina.html\">Lentes em Resina</a>\n                <a href=\"/paginas/lentes-em-porcelana.html\">Lentes Premium</a>\n                <a href=\"/paginas/botox.html\">Botox</a>\n                <a href=\"/paginas/harmonizacao-facial.html\">Harmonização Facial</a>\n                <a href=\"/paginas/gengivoplastia.html\">Gengivoplastia</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Informações</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__stack site-footer__panel\">\n                <a href=\"mailto:vitoriavieira_vic@hotmail.com\">vitoriavieira_vic@hotmail.com</a>\n                <a href=\"https://wa.me/5511915023134?text=Ol%C3%A1%2C%20vim%20do%20site%20e%20gostaria%20de%20efetuar%20um%20agendamento.\" data-whatsapp-link>Fale comigo no WhatsApp</a>\n                <p>Rua Alm. Brasil, 685 - Mooca, São Paulo</p>\n                <p>CEP 03162-010</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </div>";
const data = await getServiceData('preenchimento-labial');
const head = renderHead(fallbackHead, data?.page?.seo, data?.settings);
const content = renderServiceContent(fallbackContent, data);
