const fallbackHead = "<meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <script>\n    window.__chromium_devtools_metrics_reporter =\n      window.__chromium_devtools_metrics_reporter || function () {};\n  </script>\n  <title>Gengivoplastia | Dra. Vitória Passos</title>\n  <base href=\"../\" />\n  <meta\n    name=\"description\"\n    content=\"Gengivoplastia com Dra. Vitória Passos em São Paulo para corrigir sorriso gengival, equilibrar a gengiva e valorizar a estética do sorriso.\"\n  />\n  <meta name=\"robots\" content=\"index, follow\" />\n  <meta name=\"author\" content=\"Dra. Vitória Passos\" />\n  <meta name=\"theme-color\" content=\"#62162f\" />\n  <link rel=\"canonical\" href=\"/paginas/gengivoplastia.html\" />\n  <meta property=\"og:locale\" content=\"pt_BR\" />\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:title\" content=\"Gengivoplastia | Dra. Vitória Passos\" />\n  <meta\n    property=\"og:description\"\n    content=\"Gengivoplastia para contorno gengival mais harmônico, sorriso equilibrado e resultado natural.\"\n  />\n  <meta property=\"og:image\" content=\"/assets/images/hero-vitoria.jpg\" />\n  <meta property=\"og:image:alt\" content=\"Dra. Vitória Passos em atendimento odontológico\" />\n  <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  <meta name=\"twitter:title\" content=\"Gengivoplastia | Dra. Vitória Passos\" />\n  <meta\n    name=\"twitter:description\"\n    content=\"Procedimento estético gengival com foco em simetria, segurança e naturalidade em São Paulo.\"\n  />\n  <meta name=\"twitter:image\" content=\"/assets/images/hero-vitoria.jpg\" />\n  <link rel=\"stylesheet\" href=\"/assets/css/styles.css?v=journey-gradient-tall-20260922a\" />\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/images/favicon-pisom.svg?v=favicon-pisom-20260921a\" />\n  <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Dentist\",\n      \"name\": \"Pisom Odontologia Dra Vitória Passos - Odontologia Estética\",\n      \"email\": \"mailto:vitoriavieira_vic@hotmail.com\",\n      \"telephone\": \"+55 11 91502-3134\",\n      \"taxID\": \"61.201.382/0001-06\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"streetAddress\": \"Rua Alm Brasil 685 Conj 107\",\n        \"addressLocality\": \"São Paulo\",\n        \"addressRegion\": \"SP\",\n        \"postalCode\": \"03162-010\",\n        \"addressCountry\": \"BR\"\n      }\n    }\n  </script>";
const fallbackContent = "<header class=\"site-header\" data-mobile-nav>\n        <a class=\"brand\" href=\"/index.html\" aria-label=\"Ir para a home\">\n          <img\n            class=\"brand__logo\"\n            src=\"/assets/images/pisom-header-logo.svg\"\n            alt=\"Logo Pisom Odontologia\"\n            width=\"128\"\n            height=\"96\"\n          />\n        </a>\n\n        <button\n          class=\"site-header__toggle\"\n          type=\"button\"\n          aria-expanded=\"false\"\n          aria-controls=\"site-header-panel\"\n          aria-label=\"Abrir menu\"\n        >\n          <span></span>\n          <span></span>\n          <span></span>\n        </button>\n\n        <div class=\"site-header__panel\" id=\"site-header-panel\">\n          <nav class=\"site-nav\" aria-label=\"Navegação principal\">\n            <a href=\"/paginas/lentes-em-resina.html\">Lentes em Resina</a>\n            <a href=\"/paginas/lentes-em-porcelana.html\">Lentes Premium</a>\n            <a href=\"/paginas/botox.html\">Botox</a>\n            <a href=\"/paginas/preenchimento-labial.html\">Preenchimento Labial</a>\n            <a href=\"/paginas/gengivoplastia.html\">Gengivoplastia</a>\n          </nav>\n\n          <a class=\"button button--ghost site-header__cta\" data-whatsapp-link href=\"#\">\n            Agendar avaliação\n          </a>\n        </div>\n      </header>\n\n      <main>\n  <!-- HERO -->\n  <section class=\"hero\">\n    <div class=\"hero__content reveal\">\n      <span class=\"eyebrow\">GENGIVOPLASTIA</span>\n      <h1 class=\"hero__title\">Sorriso equilibrado.<br>Gengiva <em>perfeita.</em></h1>\n      <p class=\"hero__desc\">A gengivoplastia remodela o contorno gengival para revelar um sorriso mais simétrico, harmonioso e bonito — com precisão e mínimo desconforto.</p>\n      <div class=\"hero__actions\">\n        <a href=\"#\" class=\"btn btn--primary\" data-whatsapp-link>Agendar avaliação</a>\n      </div>\n      <div class=\"hero__tags\">\n        <span class=\"tag\">Procedimento rápido</span>\n        <span class=\"tag\">Resultado definitivo</span>\n        <span class=\"tag\">A laser ou bisturi</span>\n      </div>\n    </div>\n    <div class=\"hero__visual reveal reveal--right\">\n      <div class=\"hero__image-wrap\">\n        <img src=\"./assets/images/real/gengivoplastia-hero-antes-depois.png\" alt=\"Caso de gengivoplastia com antes e depois\" class=\"hero__img\" />\n        <div class=\"hero__badge\">\n          <span class=\"badge__number\">500+</span>\n          <span class=\"badge__label\">procedimentos realizados</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n        <section id=\"tratamentos-gengivoplastia\" class=\"section treatments-showcase treatments-showcase--gengivoplastia\" data-treatment-carousel=\"gengivoplastia\">\n          <div class=\"section-heading\">\n            <p class=\"eyebrow\">Tratamentos</p>\n            <h2 class=\"section-heading__title--wide\">Tratamentos estéticos pensados para transformar sorrisos e harmonizar resultados.</h2>\n            <p>\n              Conheça os procedimentos da Dra. Vitória Passos e veja como cada\n              detalhe pode valorizar o seu sorriso com naturalidade.\n            </p>\n          </div>\n\n          <div class=\"transformations-marquee transformations-marquee--gengivoplastia\" aria-label=\"Galeria de transformações de Gengivoplastia\">\n            <div class=\"transformations-marquee__track\">\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/preenchimento-labial.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/preenchimento-labial-caso.jpg\" alt=\"Caso de preenchimento labial com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Preenchimento Labial</strong>\n                  <span>Antes e depois com contorno, equilíbrio e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-1.png\" alt=\"Caso de botox com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Suavização das linhas com resultado leve e expressão preservada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-1.jpg\" alt=\"Caso de lentes em resina com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes em Resina</strong>\n                  <span>Transformação do sorriso com brilho, forma e naturalidade.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-2.jpg\" alt=\"Outro caso de lentes em resina com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong class=\"transformation-card__title--long\">Lentes em Resina + Gengivoplastia</strong>\n                  <span>Lentes em resina e gengivoplastia para mais simetria e um sorriso sofisticado.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-porcelana.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-premium.jpg\" alt=\"Caso de lentes premium com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes Premium</strong>\n                  <span>Transformação premium do sorriso com estética clara, brilho e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/gengivoplastia.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/gengivoplastia-caso.jpg\" alt=\"Caso de gengivoplastia com antes, procedimento e resultado\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Gengivoplastia</strong>\n                  <span>Contorno gengival mais harmônico para destacar o sorriso.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-2.png\" alt=\"Outro caso de botox com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Mais leveza na testa e leitura facial mais descansada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/preenchimento-labial.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/preenchimento-labial-caso.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Preenchimento Labial</strong>\n                  <span>Antes e depois com contorno, equilíbrio e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-1.png\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Suavização das linhas com resultado leve e expressão preservada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-1.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes em Resina</strong>\n                  <span>Transformação do sorriso com brilho, forma e naturalidade.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-2.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong class=\"transformation-card__title--long\">Lentes em Resina + Gengivoplastia</strong>\n                  <span>Lentes em resina e gengivoplastia para mais simetria e um sorriso sofisticado.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-porcelana.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-premium.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes Premium</strong>\n                  <span>Transformação premium do sorriso com estética clara, brilho e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/gengivoplastia.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/gengivoplastia-caso.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Gengivoplastia</strong>\n                  <span>Contorno gengival mais harmônico para destacar o sorriso.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-2.png\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Mais leveza na testa e leitura facial mais descansada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n            </div>\n          </div>\n\n        </section>\n\n  <!-- O QUE É -->\n  <section class=\"what-is section what-is--cards-only\">\n    <div class=\"container\">\n      <div class=\"what-is__grid\">\n<div class=\"what-is__cards reveal reveal--right\">\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Agilidade</div>\n            <h3>Procedimento em 1 sessão</h3>\n            <p>A gengivoplastia é realizada em uma única visita, com duração entre 30 e 60 minutos dependendo da extensão do tratamento.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Resultado</div>\n            <h3>Resultado definitivo</h3>\n            <p>A gengiva remodelada não volta ao estado anterior, garantindo um resultado permanente e duradouro.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Tecnologia</div>\n            <h3>Tecnologia a laser</h3>\n            <p>O laser de diodo oferece mais precisão, menor sangramento e cicatrização mais rápida em comparação ao bisturi convencional.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Segurança</div>\n            <h3>Anestesia local</h3>\n            <p>O procedimento é feito com anestesia local, garantindo total conforto durante a realização da gengivoplastia.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- INDICAÇÕES -->\n  <section class=\"areas section section--dark\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>INDICAÇÕES</span>\n      </div>\n      <h2 class=\"section-title text-center reveal\">Quando a gengivoplastia<br>é <em>indicada?</em></h2>\n      <div class=\"areas__grid\">\n        <div class=\"area-card reveal\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1588776814546-ec7e21ada5f8?w=500&q=80\" alt=\"Sorriso gengival\" />\n            <span class=\"area-card__label\">Sorriso Gengival</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Sorriso gengival</h3>\n            <p>Corrige o excesso de gengiva aparente ao sorrir, equilibrando a proporção entre dentes e gengiva.</p>\n          </div>\n        </div>\n        <div class=\"area-card reveal reveal--delay1\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1598256539584-8b94d24d70b4?w=500&q=80\" alt=\"Dentes curtos\" />\n            <span class=\"area-card__label\">Dentes Curtos</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Dentes com aparência curta</h3>\n            <p>O excesso de tecido gengival pode mascarar o tamanho real dos dentes, deixando-os com aparência menor.</p>\n          </div>\n        </div>\n        <div class=\"area-card reveal reveal--delay2\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=500&q=80\" alt=\"Assimetria gengival\" />\n            <span class=\"area-card__label\">Assimetria</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Assimetria gengival</h3>\n            <p>Regulariza os diferentes níveis gengivais entre os dentes, criando um sorriso mais simétrico e equilibrado.</p>\n          </div>\n        </div>\n        <div class=\"area-card reveal reveal--delay3\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?w=500&q=80\" alt=\"Pré lentes\" />\n            <span class=\"area-card__label\">Pré-Lentes</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Preparo para lentes</h3>\n            <p>A gengivoplastia é frequentemente indicada antes da aplicação de lentes de resina ou premium para otimizar o resultado.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- MITOS E VERDADES -->\n  <section class=\"myths section\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>MITOS E VERDADES</span>\n      </div>\n      <h2 class=\"section-title reveal section-title--two-lines\"><span>O que você precisa</span><span>saber antes de decidir.</span></h2>\n      <div class=\"before-after__carousel\" data-mobile-carousel>\n        <div class=\"myths__grid\" data-carousel-track>\n          <div class=\"myth-card myth-card--false reveal\">\n            <span class=\"myth-badge myth-badge--false\">MITO</span>\n            <h3>\"A gengivoplastia é muito dolorosa\"</h3>\n            <p>O procedimento é realizado com anestesia local, tornando a sessão confortável. No pós-operatório, pode haver sensibilidade leve que é facilmente controlada com analgésicos comuns.</p>\n          </div>\n          <div class=\"myth-card myth-card--true reveal reveal--delay1\">\n            <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n            <h3>\"O resultado é permanente\"</h3>\n            <p>Diferente de outros procedimentos estéticos, a gengivoplastia tem resultado definitivo. A gengiva remodelada não retorna ao estado anterior.</p>\n          </div>\n          <div class=\"myth-card myth-card--false reveal reveal--delay2\">\n            <span class=\"myth-badge myth-badge--false\">MITO</span>\n            <h3>\"A recuperação é longa e difícil\"</h3>\n            <p>Com o uso do laser de diodo, a cicatrização é mais rápida. A maioria dos pacientes retorna às atividades normais em 24 a 48 horas, com desconforto mínimo.</p>\n          </div>\n          <div class=\"myth-card myth-card--true reveal reveal--delay3\">\n            <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n            <h3>\"Melhora muito o resultado das lentes\"</h3>\n            <p>A gengivoplastia antes das lentes de resina ou premium é fundamental para expor a área correta do dente e garantir um resultado muito mais harmonioso e bonito.</p>\n          </div>\n          <div class=\"myth-card myth-card--false reveal\">\n            <span class=\"myth-badge myth-badge--false\">MITO</span>\n            <h3>\"É um procedimento só estético\"</h3>\n            <p>Além da estética, a gengivoplastia também pode facilitar a higienização dos dentes, contribuindo para a saúde bucal e prevenção de doenças periodontais.</p>\n          </div>\n          <div class=\"myth-card myth-card--true reveal reveal--delay1\">\n            <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n            <h3>\"O laser torna o procedimento mais seguro\"</h3>\n            <p>O laser de diodo esteriliza enquanto corta, reduzindo o risco de infecção e proporcionando maior controle e precisão durante todo o procedimento.</p>\n          </div>\n        </div>\n        <div class=\"before-after__controls\" aria-label=\"Navegação dos mitos e verdades\">\n          <div class=\"before-after__dots\" data-carousel-dots></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section class=\"faq section\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>DÚVIDAS COMUNS</span>\n      </div>\n      <h2 class=\"section-title reveal\">Perguntas que ajudam<br>a decidir com mais segurança.</h2>\n      <div class=\"faq__grid\">\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>A gengivoplastia dói?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Não durante o procedimento, pois é feito com anestesia local. Após, pode haver sensibilidade leve e inchaço nos primeiros dias, controlados com medicação prescrita pela Dra. Vitória.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Quanto tempo dura a recuperação?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Com o laser, a recuperação é rápida. A maioria dos pacientes retorna às atividades em 24 a 48 horas. A cicatrização completa ocorre em 2 a 4 semanas, quando o resultado definitivo é visível.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>O resultado da gengivoplastia é permanente?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Sim! A gengiva remodelada não volta ao estado anterior. É um dos poucos procedimentos estéticos com resultado verdadeiramente definitivo. Em casos de hiperplasia gengival por uso de medicamentos, pode haver recidiva se o fármaco for mantido.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Posso fazer gengivoplastia e lentes na mesma sessão?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Geralmente são realizadas em sessões separadas. A gengivoplastia é feita primeiro e, após a cicatrização completa (4 a 6 semanas), é o momento ideal para iniciar o tratamento com lentes, garantindo um resultado ainda mais perfeito.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Preciso de algum cuidado especial após o procedimento?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Recomendamos alimentação fria e pastosa nas primeiras 24h, evitar esforço físico intenso, não fumar e higienizar com cuidado na região. A Dra. Vitória fornece um protocolo completo pós-operatório.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Qual é a diferença entre gengivoplastia e gengivectomia?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>A gengivectomia é a remoção do tecido gengival, enquanto a gengivoplastia é o remodelamento para fins estéticos. Na prática clínica moderna, ambos os termos são frequentemente usados de forma intercambiável para descrever o mesmo procedimento estético.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- CTA FINAL -->\n  <section class=\"cta-final section\" id=\"agendar\">\n    <div class=\"container\">\n      <div class=\"cta-final__inner reveal\">\n        <span class=\"eyebrow\">PRÓXIMO PASSO</span>\n        <h2>Pronta para sorrir<br>com confiança?</h2>\n        <p>Agende sua avaliação com a Dra. Vitória Passos e descubra como a gengivoplastia pode transformar o seu sorriso.</p>\n        <div class=\"cta-final__actions\">\n          <a href=\"#\" target=\"_blank\" class=\"btn btn--primary btn--large\" data-whatsapp-link>\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n              <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"/>\n            </svg>\n            Falar no WhatsApp\n          </a>\n          <a href=\"#\" class=\"btn btn--ghost-dark\">Ver Instagram</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n      <footer class=\"site-footer site-footer--rich\">\n        <div class=\"site-footer__surface\">\n          <div class=\"site-footer__top\">\n            <div class=\"site-footer__intro\">\n              <img\n                class=\"site-footer__logo\"\n                src=\"/assets/images/pison-odontologia-branco-sem-fundo.svg\"\n                alt=\"Logo Pisom Odontologia\"\n                width=\"180\"\n                height=\"120\"\n              />\n              <p>\n                Na Pisom Odontologia, cada avaliação é pensada com cuidado,\n                clareza e foco em resultados estéticos naturais.\n              </p>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Institucional</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/index.html\">Home</a>\n                <a href=\"/index.html#sobre\">Sobre</a>\n                <a href=\"/index.html#duvidas\">Dúvidas</a>\n                <a href=\"/politica-de-privacidade.html\">Política de Privacidade</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Tratamentos</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/paginas/lentes-em-resina.html\">Lentes em Resina</a>\n                <a href=\"/paginas/lentes-em-porcelana.html\">Lentes Premium</a>\n                <a href=\"/paginas/botox.html\">Botox</a>\n                <a href=\"/paginas/harmonizacao-facial.html\">Harmonização Facial</a>\n                <a href=\"/paginas/gengivoplastia.html\">Gengivoplastia</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Informações</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__stack site-footer__panel\">\n                <a href=\"mailto:vitoriavieira_vic@hotmail.com\">vitoriavieira_vic@hotmail.com</a>\n                <a href=\"https://wa.me/5511915023134?text=Ol%C3%A1%2C%20vim%20do%20site%20e%20gostaria%20de%20efetuar%20um%20agendamento.\" data-whatsapp-link>Fale comigo no WhatsApp</a>\n                <p>Rua Alm. Brasil, 685 - Mooca, São Paulo</p>\n                <p>CEP 03162-010</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </main>";
