        </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/index.html\">Home</a>\n                <a href=\"/index.html#sobre\">Sobre</a>\n                <a href=\"/index.html#duvidas\">Dúvidas</a>\n                <a href=\"/politica-de-privacidade.html\">Política de Privacidade</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Tratamentos</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/paginas/lentes-em-resina.html\">Lentes em Resina</a>\n                <a href=\"/paginas/lentes-em-porcelana.html\">Lentes Premium</a>\n                <a href=\"/paginas/botox.html\">Botox</a>\n                <a href=\"/paginas/harmonizacao-facial.html\">Harmonização Facial</a>\n                <a href=\"/paginas/gengivoplastia.html\">Gengivoplastia</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Informações</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__stack site-footer__panel\">\n                <a href=\"mailto:vitoriavieira_vic@hotmail.com\">vitoriavieira_vic@hotmail.com</a>\n                <a href=\"https://wa.me/5511915023134?text=Ol%C3%A1%2C%20vim%20do%20site%20e%20gostaria%20de%20efetuar%20um%20agendamento.\" data-whatsapp-link>Fale comigo no WhatsApp</a>\n                <p>Rua Alm. Brasil, 685 - Mooca, São Paulo</p>\n                <p>C