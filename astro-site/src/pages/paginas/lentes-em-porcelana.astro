ges/real/lentes-premium/carrossel/premium-carrossel-12.webp\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes Premium</strong>\n                  <span>Antes e depois masculino com sorriso mais alinhado e luminoso.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n            </div>\n          </div>\n\n        </section>\n  <!-- POR QUE PREMIUM -->\n  <section class=\"section premium-editorial premium-editorial--value\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>POR QUE PREMIUM</span>\n      </div>\n      <h2 class=\"section-title reveal\">Um resultado pensado para durar, brilhar e continuar natural.</h2>\n      <div class=\"premium-editorial__copy reveal\">\n        <p>\n          As Lentes Premium são indicadas para quem deseja uma transformação mais refinada, com maior estabilidade de cor, resistência ao manchamento e acabamento estético superior. O objetivo é construir um sorriso luminoso e sofisticado sem perder a naturalidade do rosto.\n        </p>\n        <p>\n          Diferente de uma mudança rápida e mais simples, o protocolo Premium envolve planejamento, escolha cuidadosa de formato, proporção, cor e textura. Isso permite um resultado mais previsível, mais duradouro e com aquela leitura de sorriso bem cuidado, elegante e harmônico.\n        </p>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- O QUE É -->\n  <section class=\"what-is section what-is--cards-only\">\n    <div class=\"container\">\n      <div class=\"what-is__grid\">\n<div class=\"what-is__cards reveal reveal--right\">\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Digital</div>\n            <h3>Simulação digital prévia</h3>\n            <p>Você visualiza o sorriso planejado antes de iniciar qualquer procedimento, garantindo total segurança na decisão.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Premium</div>\n            <h3>Resultado em 2 a 3 sessões</h3>\n            <p>O protocolo completo, do planejamento à instalação final, é concluído em poucas visitas ao consultório.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Duração</div>\n            <h3>Dura até 15 anos</h3>\n            <p>Com cuidados adequados, as Lentes Premium têm durabilidade excepcional e resistência ao manchamento.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Estética</div>\n            <h3>Aparência ultra-natural</h3>\n            <p>A translucidez das Lentes Premium imita perfeitamente o esmalte dentário, resultando em um sorriso que parece natural.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n  <!-- ETAPAS DO TRATAMENTO -->\n  <section class=\"process section premium-process\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>PROCESSO</span>\n      </div>\n      <h2 class=\"section-title reveal\">Um protocolo planejado antes de qualquer mudança.</h2>\n      <div class=\"process__steps reveal\">\n        <div class=\"process-step\">\n          <span class=\"step-number\">01</span>\n          <div class=\"step-body\">\n            <h3>Avaliação estética</h3>\n            <p>Entendimento do sorriso, queixas, formato do rosto e expectativa de resultado.</p>\n          </div>\n        </div>\n        <div class=\"process-step\">\n          <span class=\"step-number\">02</span>\n          <div class=\"step-body\">\n            <h3>Planejamento</h3>\n            <p>Definição de cor, forma, proporção e harmonia para orientar a transformação.</p>\n          </div>\n        </div>\n        <div class=\"process-step\">\n          <span class=\"step-number\">03</span>\n          <div class=\"step-body\">\n            <h3>Prova e ajustes</h3>\n            <p>O sorriso é avaliado com calma para alinhar conforto, estética e naturalidade.</p>\n          </div>\n        </div>\n        <div class=\"process-step\">\n          <span class=\"step-number\">04</span>\n          <div class=\"step-body\">\n            <h3>Instalação final</h3>\n            <p>Finalização das lentes com acabamento, polimento e orientação de cuidados.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- COMPARAÇÃO -->\n  <section class=\"section lens-compare lens-compare--editorial lens-compare--premium\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>COMPARAÇÃO</span>\n      </div>\n      <h2 class=\"section-title reveal\">Tradicionais ou Premium:<br>o que faz mais sentido?</h2>\n      <div class=\"lens-compare__copy reveal\">\n        <p>\n          As Lentes Tradicionais são uma ótima alternativa quando o objetivo é renovar o sorriso com agilidade, bom custo-benefício e ajustes mais diretos de forma, cor e proporção. Elas funcionam muito bem para mudanças leves e para quem quer começar por um caminho mais acessível.\n        </p>\n        <p>\n          As Lentes Premium entram quando a prioridade é um resultado mais estável, resistente e sofisticado. A escolha costuma fazer mais sentido para quem deseja maior durabilidade, acabamento superior, brilho mais refinado e uma estética que se mantenha bonita por mais tempo.\n        </p>\n        <p>\n          Na avaliação, a Dra. Vitória te ajuda a entender o que combina com seu sorriso. Mas se você quer investir em previsibilidade, longevidade e acabamento de alto padrão, o Premium tende a ser o caminho mais completo.\n        </p>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- MITOS E VERDADES -->\n  <section class=\"myths section\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>MITOS E VERDADES</span>\n      </div>\n      <h2 class=\"section-title reveal section-title--two-lines\"><span>O que você precisa</span><span>saber antes de decidir.</span></h2>\n      <div class=\"before-after__carousel\" data-mobile-carousel>\n      <div class=\"myths__grid\" data-carousel-track>\n        <div class=\"myth-card myth-card--false reveal\">\n          <span class=\"myth-badge myth-badge--false\">MITO</span>\n          <h3>\"Depois de colocar, não posso comer normalmente\"</h3>\n          <p>Após a adaptação e as orientações da Dra. Vitória, a rotina alimentar pode seguir normalmente. O principal cuidado é evitar exageros com alimentos muito duros nos dentes da frente.</p>\n        </div>\n        <div class=\"myth-card myth-card--false reveal reveal--delay1\">\n          <span class=\"myth-badge myth-badge--false\">MITO</span>\n          <h3>\"As lentes ficam sensíveis para sempre\"</h3>\n          <p>Uma sensibilidade leve pode acontecer nos primeiros dias, mas não deve ser algo permanente. Quando o caso é bem planejado e acompanhado, o conforto tende a se estabilizar.</p>\n        </div>\n        <div class=\"myth-card myth-card--true reveal reveal--delay2\">\n          <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n          <h3>\"As revisões ajudam a manter o resultado bonito\"</h3>\n          <p>Consultas periódicas permitem acompanhar gengiva, mordida, brilho e adaptação das lentes. Esse cuidado ajuda o resultado a permanecer estável e bem acabado por mais tempo.</p>\n        </div>\n        <div class=\"myth-card myth-card--false reveal reveal--delay3\">\n          <span class=\"myth-badge myth-badge--false\">MITO</span>\n          <h3>\"Não precisa fazer manutenção depois\"</h3>\n          <p>Mesmo com alta durabilidade, o acompanhamento continua importante. Revisões, higiene adequada e polimentos quando indicados ajudam a preservar brilho, gengiva saudável e acabamento.</p>\n        </div>\n        <div class=\"myth-card myth-card--true reveal\">\n          <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n          <h3>\"Placa de bruxismo pode ser necessária\"</h3>\n          <p>Quando existe apertamento ou bruxismo, a placa noturna pode ser indicada para proteger as lentes e trazer mais segurança para o resultado no dia a dia.</p>\n        </div>\n        <div class=\"myth-card myth-card--false reveal reveal--delay1\">\n          <span class=\"myth-badge myth-badge--false\">MITO</span>\n          <h3>\"Se algo incomodar, é só esperar passar\"</h3>\n          <p>Qualquer incômodo na mordida, gengiva ou adaptação deve ser avaliado. Pequenos ajustes no momento certo evitam desconfortos e ajudam o resultado a ficar mais confortável.</p>\n        </div>\n      </div>\n        <div class=\"before-after__controls\" aria-label=\"Navegação dos mitos e verdades\">\n          <div class=\"before-after__dots\" data-carousel-dots></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section class=\"faq section\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>DÚVIDAS COMUNS</span>\n      </div>\n      <h2 class=\"section-title reveal\">Perguntas que ajudam<br>a decidir com mais segurança.</h2>\n      <div class=\"faq__grid\">\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Qual a diferença entre resina e Lentes Premium?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>A resina é aplicada diretamente no consultório em uma sessão, tem custo menor e permite ajustes futuros. As Lentes Premium é confeccionada em laboratório, tem durabilidade superior (até 15 anos), maior resistência ao manchamento e resultado estético mais refinado. A Dra. Vitória indica a melhor opção para cada caso.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>As lentes machucam ou danificam os dentes?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Não. As lentes modernas exigem desgaste mínimo ou nenhum do esmalte dental. O procedimento é conservador e reversível nas lentes de resina. As Lentes Premium requerem desgaste mínimo, mas garantem resultado superior e durabilidade excepcional.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Quanto tempo dura o procedimento completo?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>As lentes de resina podem ser feitas em uma única sessão de 2 a 4 horas. As Lentes Premium exigem duas sessões: a primeira para moldagem e preparação, e a segunda (após cerca de 2 semanas) para cimentação final das lentes confeccionadas em laboratório.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Como é feita a simulação do sorriso?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Utilizamos o Digital Smile Design (DSD), onde as fotos e vídeos do seu rosto são analisados digitalmente e o novo sorriso é desenhado. Você aprova a forma, o tamanho e o tom antes de qualquer intervenção, garantindo total segurança e alinhamento de expectativas.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Preciso de algum cuidado especial com as lentes?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>A higiene é a mesma de dentes naturais. Evite morder objetos duros com os dentes da frente (canetas, unhas, caroços). Recomendamos também o uso de placa de bruxismo à noite se houver esse hábito, para preservar as lentes por mais tempo.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Posso combinar lentes com outros tratamentos?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Sim! As lentes são frequentemente combinadas com gengivoplastia (para harmonizar o contorno gengival) e clareamento dental dos dentes posteriores. A Dra. Vitória planeja o tratamento completo de forma integrada para um resultado verdadeiramente transformador.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n  <!-- CTA FINAL -->\n  <section class=\"cta-final section\" id=\"agendar\">\n    <div class=\"container\">\n      <div class=\"cta-final__inner reveal\">\n        <span class=\"eyebrow\">PRÓXIMO PASSO</span>\n        <h2>Descubra se o protocolo Premium é o caminho ideal para o seu sorriso.</h2>\n        <p>Agende sua avaliação com a Dra. Vitória Passos e entenda, com clareza, se as Lentes Premium fazem sentido para o seu caso, sua rotina e o resultado que você deseja alcançar.</p>\n        <div class=\"cta-final__actions\">\n          <a href=\"#\" class=\"btn btn--primary btn--large\" data-whatsapp-link>Agendar avaliação</a>\n          <a href=\"/paginas/lentes-em-resina.html\" class=\"btn btn--ghost-dark\">Comparar com Tradicionais</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- FOOTER -->\n      <footer class=\"site-footer site-footer--rich\">\n        <div class=\"site-footer__surface\">\n          <div class=\"site-footer__top\">\n            <div class=\"site-footer__intro\">\n              <img loading=\"lazy\" decoding=\"async\"\n                class=\"site-footer__logo\"\n                src=\"/assets/images/pison-odontologia-branco-sem-fundo.svg\"\n                alt=\"Logo Pisom Odontologia\"\n                width=\"180\"\n                height=\"120\"\n              />\n              <p>\n                Na Pisom Odontologia, cada avaliação é pensada com cuidado,\n                clareza e foco em resultados estéticos naturais.\n              </p>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Institucional</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/index.html\">Home</a>\n                <a href=\"/index.html#sobre\">Sobre</a>\n                <a href=\"/index.html#duvidas\">Dúvidas</a>\n                <a href=\"/politica-de-privacidade.html\">Política de Privacidade</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Tratamentos</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/paginas/lentes-em-resina.html\">Lentes Tradicionais</a>\n                <a href=\"/paginas/lentes-em-porcelana.html\">Lentes Premium</a>\n                <a href=\"/paginas/harmonizacao-facial.html\">Harmonização Facial</a>\n                <a href=\"/paginas/gengivoplastia.html\">Gengivoplastia</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Informações</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__stack site-footer__panel\">\n                <a href=\"mailto:vitoriavieira_vic@hotmail.com\">vitoriavieira_vic@hotmail.com</a>\n                <a href=\"https://wa.me/5511915023134?text=Ol%C3%A1%2C%20vim%20do%20site%20e%20gostaria%20de%20efetuar%20um%20agendamento.\" data-whatsapp-link>Fale comigo no WhatsApp</a>\n                <p>Rua Alm. Brasil, 685 - Mooca, São Paulo</p>\n                <p>CEP 03162-010</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </main>";
const sanityData = await getServiceData('lentes-em-porcelana');
const renderedHead = renderHead(head, sanityData?.page?.seo, sanityData?.settings, sanityData?.page?.hero?.image || sanityData?.page?.hero?.externalImage);
const renderedContent = renderServiceContent(content, sanityData);
---
<Layout head={renderedHead} bodyClass="service-page">
  <Fragment set:html={renderedContent} />
</Layout>
