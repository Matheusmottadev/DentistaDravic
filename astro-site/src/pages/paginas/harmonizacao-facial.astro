ngle\" href=\"./paginas/botox.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-2.png\" alt=\"Outro caso de botox com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Mais leveza na testa e leitura facial mais descansada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/preenchimento-labial.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/preenchimento-labial-caso.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Preenchimento Labial</strong>\n                  <span>Antes e depois com contorno, equilíbrio e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-1.png\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Suavização das linhas com resultado leve e expressão preservada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-1.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes em Resina</strong>\n                  <span>Transformação do sorriso com brilho, forma e naturalidade.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-2.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong class=\"transformation-card__title--long\">Lentes em Resina + Gengivoplastia</strong>\n                  <span>Lentes em resina e gengivoplastia para mais simetria e um sorriso sofisticado.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-porcelana.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-premium.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes Premium</strong>\n                  <span>Transformação premium do sorriso com estética clara, brilho e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/gengivoplastia.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/gengivoplastia-caso.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Gengivoplastia</strong>\n                  <span>Contorno gengival mais harmônico para destacar o sorriso.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-2.png\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Mais leveza na testa e leitura facial mais descansada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n            </div>\n          </div>\n\n        </section>\n\n  <!-- O QUE É -->\n  <section class=\"what-is section what-is--cards-only\">\n    <div class=\"container\">\n      <div class=\"what-is__grid\">\n<div class=\"what-is__cards reveal reveal--right\">\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Resultado</div>\n            <h3>Resultado imediato</h3>\n            <p>O ácido hialurônico promove volume e definição logo após a aplicação, com resultado progressivo em 15 dias.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Precisão</div>\n            <h3>100% personalizado</h3>\n            <p>Cada protocolo é planejado de acordo com a anatomia facial única de cada paciente.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Duração</div>\n            <h3>Dura de 12 a 18 meses</h3>\n            <p>O resultado é duradouro e pode ser aprimorado a cada sessão de manutenção.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Segurança</div>\n            <h3>Seguro e aprovado</h3>\n            <p>Produtos aprovados pela ANVISA, aplicados com técnica e rigor por profissional habilitada.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ÁREAS -->\n  <section class=\"areas section section--dark\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>ÁREAS TRATADAS</span>\n      </div>\n      <h2 class=\"section-title text-center reveal\">Cada detalhe do rosto<br>pode ser <em>harmonizado.</em></h2>\n      <div class=\"areas__grid\">\n        <div class=\"area-card reveal\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?w=500&q=80\" alt=\"Preenchimento labial\" />\n            <span class=\"area-card__label\">Lábios</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Preenchimento labial</h3>\n            <p>Define o contorno, adiciona volume e equilibra a proporção entre lábio superior e inferior.</p>\n          </div>\n        </div>\n        <div class=\"area-card reveal reveal--delay1\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1508214751196-bcfd4ca60f91?w=500&q=80\" alt=\"Papada e mandíbula\" />\n            <span class=\"area-card__label\">Mandíbula</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Definição de mandíbula</h3>\n            <p>Cria um contorno mais definido e elegante, equilibrando o terço inferior do rosto.</p>\n          </div>\n        </div>\n        <div class=\"area-card reveal reveal--delay2\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1522338242992-e1a54906a8da?w=500&q=80\" alt=\"Nariz\" />\n            <span class=\"area-card__label\">Nariz</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Rinoplastia não-cirúrgica</h3>\n            <p>Corrige assimetrias e suaviza o perfil nasal sem bisturi, de forma rápida e segura.</p>\n          </div>\n        </div>\n        <div class=\"area-card reveal reveal--delay3\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1552693673-1bf958298935?w=500&q=80\" alt=\"Maçãs do rosto\" />\n            <span class=\"area-card__label\">Maçãs</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Projeção malar</h3>\n            <p>Restaura ou cria volume nas maçãs do rosto para uma aparência mais jovial e estruturada.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- MITOS E VERDADES -->\n  <section class=\"myths section\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>MITOS E VERDADES</span>\n      </div>\n      <h2 class=\"section-title reveal section-title--two-lines\"><span>O que você precisa</span><span>saber antes de decidir.</span></h2>\n      <div class=\"before-after__carousel\" data-mobile-carousel>\n      <div class=\"myths__grid\" data-carousel-track>\n        <div class=\"myth-card myth-card--false reveal\">\n          <span class=\"myth-badge myth-badge--false\">MITO</span>\n          <h3>\"Harmonização deixa a aparência artificial\"</h3>\n          <p>Quando planejada com critério técnico e estético, a harmonização facial realça os traços naturais sem criar um resultado exagerado. O segredo está na individualização.</p>\n        </div>\n        <div class=\"myth-card myth-card--true reveal reveal--delay1\">\n          <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n          <h3>\"Os resultados são reversíveis\"</h3>\n          <p>O ácido hialurônico pode ser dissolvido com hialuronidase a qualquer momento. Isso torna o procedimento mais seguro e flexível para ajustes futuros.</p>\n        </div>\n        <div class=\"myth-card myth-card--false reveal reveal--delay2\">\n          <span class=\"myth-badge myth-badge--false\">MITO</span>\n          <h3>\"Só faz quem já tem muitas marcas\"</h3>\n          <p>A harmonização facial é indicada para diferentes faixas etárias, desde a prevenção em jovens até a restauração de volume perdido em pacientes mais maduros.</p>\n        </div>\n        <div class=\"myth-card myth-card--true reveal reveal--delay3\">\n          <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n          <h3>\"É possível combinar vários procedimentos\"</h3>\n          <p>O protocolo de harmonização pode unir preenchimento, Botox e bioestimuladores em uma única sessão, com resultado muito mais completo e harmonioso.</p>\n        </div>\n        <div class=\"myth-card myth-card--false reveal\">\n          <span class=\"myth-badge myth-badge--false\">MITO</span>\n          <h3>\"A recuperação é longa e complicada\"</h3>\n          <p>A maioria dos procedimentos tem recuperação rápida, com possibilidade de pequenos hematomas que somem em poucos dias. É possível retornar às atividades no mesmo dia.</p>\n        </div>\n        <div class=\"myth-card myth-card--true reveal reveal--delay1\">\n          <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n          <h3>\"Profissional qualificado faz toda a diferença\"</h3>\n          <p>A harmonização exige conhecimento profundo de anatomia facial. A escolha do profissional é o fator mais importante para um resultado seguro e bonito.</p>\n        </div>\n      </div>\n        <div class=\"before-after__controls\" aria-label=\"Navegação dos mitos e verdades\">\n          <div class=\"before-after__dots\" data-carousel-dots></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- PROCESSO -->\n  <section class=\"process section section--beige\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>COMO FUNCIONA</span>\n      </div>\n      <h2 class=\"section-title text-center reveal\">Do planejamento ao resultado:<br>cada etapa com cuidado.</h2>\n      <div class=\"process__steps\">\n        <div class=\"process-step reveal\">\n          <div class=\"step-number\">01</div>\n          <div class=\"step-body\">\n            <h3>Avaliação facial</h3>\n            <p>A Dra. Vitória analisa proporções, traços e objetivos para criar um plano personalizado e seguro.</p>\n          </div>\n        </div>\n        <div class=\"process-step reveal reveal--delay1\">\n          <div class=\"step-number\">02</div>\n          <div class=\"step-body\">\n            <h3>Mapeamento dos pontos</h3>\n            <p>São marcados os pontos estratégicos de aplicação com base na anatomia facial de cada paciente.</p>\n          </div>\n        </div>\n        <div class=\"process-step reveal reveal--delay2\">\n          <div class=\"step-number\">03</div>\n          <div class=\"step-body\">\n            <h3>Aplicação com precisão</h3>\n            <p>O procedimento é feito com cânulas e agulhas finas, priorizando conforto e segurança durante toda a sessão.</p>\n          </div>\n        </div>\n        <div class=\"process-step reveal reveal--delay3\">\n          <div class=\"step-number\">04</div>\n          <div class=\"step-body\">\n            <h3>Acompanhamento pós</h3>\n            <p>A Dra. Vitória acompanha a evolução e realiza ajustes finos quando necessário para o resultado ideal.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section class=\"faq section\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>DÚVIDAS COMUNS</span>\n      </div>\n      <h2 class=\"section-title reveal\">Perguntas que ajudam<br>a decidir com mais segurança.</h2>\n      <div class=\"faq__grid\">\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>A harmonização facial dói?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>O desconforto é mínimo. Os produtos já contêm anestésico em sua fórmula e, quando necessário, aplicamos creme anestésico antes do procedimento. A maioria dos pacientes relata uma sensação de pressão leve, sem dor significativa.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Quando verei o resultado completo?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>O resultado é imediato após a aplicação, mas o efeito final é observado em cerca de 15 dias, quando o produto se integra completamente aos tecidos e pequenos edemas somem.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Posso fazer harmonização mais de uma vez?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Sim! A harmonização é cumulativa: cada sessão pode aprimorar e complementar o resultado anterior. A manutenção é recomendada a cada 12 a 18 meses, dependendo do metabolismo de cada paciente.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>E se eu não gostar do resultado?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>O ácido hialurônico pode ser dissolvido com uma enzima chamada hialuronidase. Esse é um grande diferencial do procedimento: é reversível, o que garante muito mais segurança e tranquilidade para o paciente.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Tenho que fazer repouso após o procedimento?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Não é necessário repouso prolongado. Recomendamos evitar exercícios físicos intensos e exposição ao calor nas primeiras 24h. A maioria dos pacientes retorna às atividades normais no mesmo dia.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Posso combinar com outros procedimentos?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Sim! A harmonização facial é frequentemente combinada com Botox, bioestimuladores e até procedimentos odontológicos como lentes de resina, para um resultado ainda mais completo e harmonioso.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- CTA FINAL -->\n  <section class=\"cta-final section\" id=\"agendar\">\n    <div class=\"container\">\n      <div class=\"cta-final__inner reveal\">\n        <span class=\"eyebrow\">PRÓXIMO PASSO</span>\n        <h2>Pronta para descobrir<br>o melhor do seu rosto?</h2>\n        <p>Agende sua avaliação com a Dra. Vitória Passos e entenda qual protocolo de harmonização faz sentido para você.</p>\n        <div class=\"cta-final__actions\">\n          <a href=\"#\" target=\"_blank\" class=\"btn btn--primary btn--large\" data-whatsapp-link>\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n              <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"/>\n            </svg>\n            Falar no WhatsApp\n          </a>\n          <a href=\"#\" class=\"btn btn--ghost-dark\">Ver Instagram</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n      <footer class=\"site-footer site-footer--rich\">\n        <div class=\"site-footer__surface\">\n          <div class=\"site-footer__top\">\n            <div class=\"site-footer__intro\">\n              <img\n                class=\"site-footer__logo\"\n                src=\"/assets/images/pison-odontologia-branco-sem-fundo.svg\"\n                alt=\"Logo Pisom Odontologia\"\n                width=\"180\"\n                height=\"120\"\n              />\n              <p>\n                Na Pisom Odontologia, cada avaliação é pensada com cuidado,\n                clareza e foco em resultados estéticos naturais.\n              </p>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Institucional</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/index.html\">Home</a>\n                <a href=\"/index.html#sobre\">Sobre</a>\n                <a href=\"/index.html#duvidas\">Dúvidas</a>\n                <a href=\"/politica-de-privacidade.html\">Política de Privacidade</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Tratamentos</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/paginas/lentes-em-resina.html\">Lentes em Resina</a>\n                <a href=\"/paginas/lentes-em-porcelana.html\">Lentes Premium</a>\n                <a href=\"/paginas/botox.html\">Botox</a>\n                <a href=\"/paginas