const fallbackHead = "<meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <script>\n    window.__chromium_devtools_metrics_reporter =\n      window.__chromium_devtools_metrics_reporter || function () {};\n  </script>\n  <title>Botox | Dra. Vitória Passos</title>\n  <base href=\"../\" />\n  <meta\n    name=\"description\"\n    content=\"Botox com Dra. Vitória Passos em São Paulo para suavizar linhas de expressão, preservar a naturalidade do rosto e valorizar a harmonia facial.\"\n  />\n  <meta name=\"robots\" content=\"index, follow\" />\n  <meta name=\"author\" content=\"Dra. Vitória Passos\" />\n  <meta name=\"theme-color\" content=\"#62162f\" />\n  <link rel=\"canonical\" href=\"/paginas/botox.html\" />\n  <meta property=\"og:locale\" content=\"pt_BR\" />\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:title\" content=\"Botox | Dra. Vitória Passos\" />\n  <meta\n    property=\"og:description\"\n    content=\"Aplicação de botox com foco em suavização elegante, expressão preservada e resultado natural.\"\n  />\n  <meta property=\"og:image\" content=\"/assets/images/hero-vitoria.jpg\" />\n  <meta property=\"og:image:alt\" content=\"Dra. Vitória Passos em atendimento estético\" />\n  <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  <meta name=\"twitter:title\" content=\"Botox | Dra. Vitória Passos\" />\n  <meta\n    name=\"twitter:description\"\n    content=\"Botox em São Paulo com foco em naturalidade, segurança e planejamento individual.\"\n  />\n  <meta name=\"twitter:image\" content=\"/assets/images/hero-vitoria.jpg\" />\n  <link rel=\"stylesheet\" href=\"/assets/css/styles.css?v=journey-gradient-tall-20260922a\" />\n  <link href=\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap\" rel=\"stylesheet\" />\n  <link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/images/favicon-pisom.svg?v=favicon-pisom-20260921a\" />\n  <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"Dentist\",\n      \"name\": \"Pisom Odontologia Dra Vitória Passos - Odontologia Estética\",\n      \"email\": \"mailto:vitoriavieira_vic@hotmail.com\",\n      \"telephone\": \"+55 11 91502-3134\",\n      \"taxID\": \"61.201.382/0001-06\",\n      \"address\": {\n        \"@type\": \"PostalAddress\",\n        \"streetAddress\": \"Rua Alm Brasil 685 Conj 107\",\n        \"addressLocality\": \"São Paulo\",\n        \"addressRegion\": \"SP\",\n        \"postalCode\": \"03162-010\",\n        \"addressCountry\": \"BR\"\n      }\n    }\n  </script>";
const fallbackContent = "<header class=\"site-header\" data-mobile-nav>\n        <a class=\"brand\" href=\"/index.html\" aria-label=\"Ir para a home\">\n          <img\n            class=\"brand__logo\"\n            src=\"/assets/images/pisom-header-logo.svg\"\n            alt=\"Logo Pisom Odontologia\"\n            width=\"128\"\n            height=\"96\"\n          />\n        </a>\n\n        <button\n          class=\"site-header__toggle\"\n          type=\"button\"\n          aria-expanded=\"false\"\n          aria-controls=\"site-header-panel\"\n          aria-label=\"Abrir menu\"\n        >\n          <span></span>\n          <span></span>\n          <span></span>\n        </button>\n\n        <div class=\"site-header__panel\" id=\"site-header-panel\">\n          <nav class=\"site-nav\" aria-label=\"Navegação principal\">\n            <a href=\"/paginas/lentes-em-resina.html\">Lentes em Resina</a>\n            <a href=\"/paginas/lentes-em-porcelana.html\">Lentes Premium</a>\n            <a href=\"/paginas/botox.html\">Botox</a>\n            <a href=\"/paginas/preenchimento-labial.html\">Preenchimento Labial</a>\n            <a href=\"/paginas/gengivoplastia.html\">Gengivoplastia</a>\n          </nav>\n\n          <a class=\"button button--ghost site-header__cta\" data-whatsapp-link href=\"#\">\n            Agendar avaliação\n          </a>\n        </div>\n      </header>\n\n      <main>\n  <!-- HERO -->\n  <section class=\"hero\">\n    <div class=\"hero__content reveal\">\n      <span class=\"eyebrow\">BOTOX FACIAL</span>\n      <h1 class=\"hero__title\">Expressão natural.<br>Resultado <em>elegante.</em></h1>\n      <p class=\"hero__desc\">Botox aplicado com precisão técnica e sensibilidade estética para suavizar marcas de expressão sem perder a naturalidade do seu rosto.</p>\n      <div class=\"hero__actions\">\n        <a href=\"#\" class=\"btn btn--primary\" data-whatsapp-link>Agendar avaliação</a>\n      </div>\n      <div class=\"hero__tags\">\n        <span class=\"tag\">Sem cirurgia</span>\n        <span class=\"tag\">Resultado em até 15 dias</span>\n        <span class=\"tag\">Procedimento rápido</span>\n      </div>\n    </div>\n    <div class=\"hero__visual reveal reveal--right\">\n      <div class=\"hero__image-wrap\">\n        <img src=\"https://images.unsplash.com/photo-1570172619644-dfd03ed5d881?w=700&q=80\" alt=\"Dra. Vitória Passos aplicando Botox\" class=\"hero__img\" />\n        <div class=\"hero__badge\">\n          <span class=\"badge__number\">500+</span>\n          <span class=\"badge__label\">procedimentos realizados</span>\n        </div>\n      </div>\n    </div>\n  </section>\n\n        <section id=\"tratamentos-botox\" class=\"section treatments-showcase treatments-showcase--botox\" data-treatment-carousel=\"botox\">\n          <div class=\"section-heading\">\n            <p class=\"eyebrow\">Tratamentos</p>\n            <h2 class=\"section-heading__title--wide\">Tratamentos estéticos pensados para transformar sorrisos e harmonizar resultados.</h2>\n            <p>\n              Conheça os procedimentos da Dra. Vitória Passos e veja como cada\n              detalhe pode valorizar o seu sorriso com naturalidade.\n            </p>\n          </div>\n\n          <div class=\"transformations-marquee transformations-marquee--botox\" aria-label=\"Galeria de transformações de Botox\">\n            <div class=\"transformations-marquee__track\">\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/preenchimento-labial.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/preenchimento-labial-caso.jpg\" alt=\"Caso de preenchimento labial com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Preenchimento Labial</strong>\n                  <span>Antes e depois com contorno, equilíbrio e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-1.png\" alt=\"Caso de botox com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Suavização das linhas com resultado leve e expressão preservada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-1.jpg\" alt=\"Caso de lentes em resina com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes em Resina</strong>\n                  <span>Transformação do sorriso com brilho, forma e naturalidade.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-2.jpg\" alt=\"Outro caso de lentes em resina com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong class=\"transformation-card__title--long\">Lentes em Resina + Gengivoplastia</strong>\n                  <span>Lentes em resina e gengivoplastia para mais simetria e um sorriso sofisticado.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-porcelana.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-premium.jpg\" alt=\"Caso de lentes premium com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes Premium</strong>\n                  <span>Transformação premium do sorriso com estética clara, brilho e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/gengivoplastia.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/gengivoplastia-caso.jpg\" alt=\"Caso de gengivoplastia com antes, procedimento e resultado\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Gengivoplastia</strong>\n                  <span>Contorno gengival mais harmônico para destacar o sorriso.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-2.png\" alt=\"Outro caso de botox com antes e depois na mesma imagem\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Mais leveza na testa e leitura facial mais descansada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/preenchimento-labial.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/preenchimento-labial-caso.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Preenchimento Labial</strong>\n                  <span>Antes e depois com contorno, equilíbrio e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-1.png\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Suavização das linhas com resultado leve e expressão preservada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-1.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes em Resina</strong>\n                  <span>Transformação do sorriso com brilho, forma e naturalidade.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-resina.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-caso-2.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong class=\"transformation-card__title--long\">Lentes em Resina + Gengivoplastia</strong>\n                  <span>Lentes em resina e gengivoplastia para mais simetria e um sorriso sofisticado.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/lentes-em-porcelana.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/lentes-premium.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Lentes Premium</strong>\n                  <span>Transformação premium do sorriso com estética clara, brilho e acabamento natural.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/gengivoplastia.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/gengivoplastia-caso.jpg\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Gengivoplastia</strong>\n                  <span>Contorno gengival mais harmônico para destacar o sorriso.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n\n              <a class=\"transformation-card transformation-card--single\" href=\"./paginas/botox.html\" aria-hidden=\"true\">\n                <div class=\"transformation-card__images transformation-card__images--single\">\n                  <img src=\"./assets/images/real/botox-caso-2.png\" alt=\"\" />\n                </div>\n                <div class=\"transformation-card__caption\">\n                  <strong>Botox</strong>\n                  <span>Mais leveza na testa e leitura facial mais descansada.</span>\n                  <em class=\"transformation-card__hint\">Clique e saiba mais</em>\n                </div>\n              </a>\n            </div>\n          </div>\n\n        </section>\n\n  <!-- O QUE É BOTOX -->\n  <section class=\"what-is section what-is--cards-only\">\n    <div class=\"container\">\n      <div class=\"what-is__grid\">\n<div class=\"what-is__cards reveal reveal--right\">\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Tempo</div>\n            <h3>30 minutos</h3>\n            <p>Duração média do procedimento, sem necessidade de internação ou recuperação longa.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Resultado</div>\n            <h3>Resultado em 15 dias</h3>\n            <p>O efeito completo aparece gradualmente, de forma natural e progressiva.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Duração</div>\n            <h3>Dura de 4 a 6 meses</h3>\n            <p>A manutenção é simples e, com o tempo, os resultados tendem a durar mais.</p>\n          </div>\n          <div class=\"info-card\">\n            <div class=\"info-card__icon\">Segurança</div>\n            <h3>Procedimento seguro</h3>\n            <p>Aprovado pela ANVISA, aplicado por profissional habilitada com CRO ativo.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ÁREAS DE TRATAMENTO -->\n  <section class=\"areas section section--dark\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>ÁREAS TRATADAS</span>\n      </div>\n      <h2 class=\"section-title text-center reveal\">Onde o Botox pode<br>transformar seu resultado.</h2>\n      <div class=\"areas__grid\">\n        <div class=\"area-card reveal\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1522338242992-e1a54906a8da?w=500&q=80\" alt=\"Testa e linhas frontais\" />\n            <span class=\"area-card__label\">Testa</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Linhas frontais</h3>\n            <p>Suaviza as rugas horizontais da testa causadas por expressões repetitivas.</p>\n          </div>\n        </div>\n        <div class=\"area-card reveal reveal--delay1\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1512290923902-8a9f81dc236c?w=500&q=80\" alt=\"Olhos e pés de galinha\" />\n            <span class=\"area-card__label\">Olhos</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Pés de galinha</h3>\n            <p>Trata as linhas ao redor dos olhos que aparecem ao sorrir ou franzir.</p>\n          </div>\n        </div>\n        <div class=\"area-card reveal reveal--delay2\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1552693673-1bf958298935?w=500&q=80\" alt=\"Glabela\" />\n            <span class=\"area-card__label\">Glabela</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Linhas entre as sobrancelhas</h3>\n            <p>Elimina a aparência de carrancudo, trazendo leveza ao olhar.</p>\n          </div>\n        </div>\n        <div class=\"area-card reveal reveal--delay3\">\n          <div class=\"area-card__img-wrap\">\n            <img src=\"https://images.unsplash.com/photo-1574480658-ca30f7bded6c?w=500&q=80\" alt=\"Botox no pescoço\" />\n            <span class=\"area-card__label\">Pescoço</span>\n          </div>\n          <div class=\"area-card__body\">\n            <h3>Pescoço e mandíbula</h3>\n            <p>Relaxa o músculo masseter (bruxismo) e suaviza bandas no pescoço.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- MITOS E VERDADES -->\n  <section class=\"myths section\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>MITOS E VERDADES</span>\n      </div>\n      <h2 class=\"section-title reveal section-title--two-lines\"><span>O que você precisa</span><span>saber antes de decidir.</span></h2>\n      <div class=\"before-after__carousel\" data-mobile-carousel>\n      <div class=\"myths__grid\" data-carousel-track>\n        <div class=\"myth-card myth-card--false reveal\">\n          <span class=\"myth-badge myth-badge--false\">MITO</span>\n          <h3>\"Botox deixa o rosto parado e sem expressão\"</h3>\n          <p>Quando aplicado corretamente e na dose ideal, o Botox preserva os movimentos naturais do rosto. O resultado travado acontece com aplicações excessivas ou mal planejadas.</p>\n        </div>\n        <div class=\"myth-card myth-card--true reveal reveal--delay1\">\n          <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n          <h3>\"Botox pode prevenir novas rugas\"</h3>\n          <p>Sim! Ao relaxar os músculos que causam as linhas de expressão, o Botox também previne que novas rugas se aprofundem ao longo do tempo.</p>\n        </div>\n        <div class=\"myth-card myth-card--false reveal reveal--delay2\">\n          <span class=\"myth-badge myth-badge--false\">MITO</span>\n          <h3>\"Botox é só para quem já tem muitas rugas\"</h3>\n          <p>O Botox preventivo, aplicado a partir dos 25-30 anos, é cada vez mais comum e eficiente para retardar o aparecimento das rugas de expressão.</p>\n        </div>\n        <div class=\"myth-card myth-card--true reveal reveal--delay3\">\n          <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n          <h3>\"O procedimento é rápido e sem internação\"</h3>\n          <p>O Botox é aplicado em consultório, dura em média 30 minutos e você sai andando normalmente. Não há necessidade de repouso prolongado.</p>\n        </div>\n        <div class=\"myth-card myth-card--false reveal\">\n          <span class=\"myth-badge myth-badge--false\">MITO</span>\n          <h3>\"Se parar de fazer, as rugas ficam piores\"</h3>\n          <p>Ao suspender o Botox, o rosto simplesmente volta ao estado natural anterior ao tratamento. Não há efeito rebote ou piora causada pelo procedimento.</p>\n        </div>\n        <div class=\"myth-card myth-card--true reveal reveal--delay1\">\n          <span class=\"myth-badge myth-badge--true\">VERDADE</span>\n          <h3>\"Botox também trata bruxismo\"</h3>\n          <p>O Botox no músculo masseter alivia a tensão causada pelo bruxismo (ranger de dentes), reduz dores na mandíbula e pode afinar o contorno facial.</p>\n        </div>\n      </div>\n        <div class=\"before-after__controls\" aria-label=\"Navegação dos mitos e verdades\">\n          <div class=\"before-after__dots\" data-carousel-dots></div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section class=\"faq section\">\n    <div class=\"container\">\n      <div class=\"section-label reveal\">\n        <span class=\"line\"></span>\n        <span>DÚVIDAS COMUNS</span>\n      </div>\n      <h2 class=\"section-title reveal\">Perguntas que ajudam<br>a decidir com mais segurança.</h2>\n      <div class=\"faq__grid\">\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>O Botox dói?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>O desconforto é mínimo. São aplicadas agulhas extremamente finas e o procedimento dura apenas alguns minutos. A maioria dos pacientes descreve como um leve picote, sem necessidade de anestesia.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Quando verei o resultado?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Os primeiros efeitos aparecem entre 3 e 5 dias após a aplicação. O resultado completo é observado em aproximadamente 15 dias, quando o músculo atinge o relaxamento ideal.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Posso fazer Botox mesmo estando amamentando?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Não é recomendado durante a gestação e o período de amamentação. A Dra. Vitória sempre faz uma anamnese completa para garantir que o procedimento é seguro para o seu caso.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Com que frequência devo repetir o Botox?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>A manutenção é recomendada a cada 4 a 6 meses. Com o tempo, muitos pacientes notam que o intervalo entre aplicações pode se alongar, pois os músculos \"aprendem\" a se contrair menos.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Posso combinar Botox com outros procedimentos?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Sim! O Botox é frequentemente combinado com preenchimento labial e harmonização facial para resultados ainda mais completos. A Dra. Vitória avaliará o que faz mais sentido para você.</p>\n          </div>\n        </div>\n        <div class=\"faq-item reveal reveal--delay1\" data-open=\"false\">\n          <button class=\"faq-question\" onclick=\"toggleFaq(this)\">\n            <span>Tenho que fazer algum preparo antes?</span>\n            <span class=\"faq-icon\">›</span>\n          </button>\n          <div class=\"faq-answer\">\n            <p>Recomenda-se evitar álcool, anti-inflamatórios e suplementos como ômega-3 nos dias anteriores para reduzir o risco de hematomas. A Dra. Vitória fornecerá todas as orientações na avaliação.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- CTA FINAL -->\n  <section class=\"cta-final section\" id=\"agendar\">\n    <div class=\"container\">\n      <div class=\"cta-final__inner reveal\">\n        <span class=\"eyebrow\">PRÓXIMO PASSO</span>\n        <h2>Pronta para uma versão<br>mais natural de você?</h2>\n        <p>Agende sua avaliação com a Dra. Vitória Passos e entenda qual tratamento faz mais sentido para o seu rosto e objetivo.</p>\n        <div class=\"cta-final__actions\">\n          <a href=\"#\" target=\"_blank\" class=\"btn btn--primary btn--large\" data-whatsapp-link>\n            <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n              <path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"/>\n            </svg>\n            Falar no WhatsApp\n          </a>\n          <a href=\"#\" class=\"btn btn--ghost-dark\">Ver Instagram</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n      <footer class=\"site-footer site-footer--rich\">\n        <div class=\"site-footer__surface\">\n          <div class=\"site-footer__top\">\n            <div class=\"site-footer__intro\">\n              <img\n                class=\"site-footer__logo\"\n                src=\"/assets/images/pison-odontologia-branco-sem-fundo.svg\"\n                alt=\"Logo Pisom Odontologia\"\n                width=\"180\"\n                height=\"120\"\n              />\n              <p>\n                Na Pisom Odontologia, cada avaliação é pensada com cuidado,\n                clareza e foco em resultados estéticos naturais.\n              </p>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Institucional</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/index.html\">Home</a>\n                <a href=\"/index.html#sobre\">Sobre</a>\n                <a href=\"/index.html#duvidas\">Dúvidas</a>\n                <a href=\"/politica-de-privacidade.html\">Política de Privacidade</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Tratamentos</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__links site-footer__panel\">\n                <a href=\"/paginas/lentes-em-resina.html\">Lentes em Resina</a>\n                <a href=\"/paginas/lentes-em-porcelana.html\">Lentes Premium</a>\n                <a href=\"/paginas/botox.html\">Botox</a>\n                <a href=\"/paginas/harmonizacao-facial.html\">Harmonização Facial</a>\n                <a href=\"/paginas/gengivoplastia.html\">Gengivoplastia</a>\n              </div>\n            </div>\n\n            <div class=\"site-footer__column site-footer__accordion\" data-footer-section>\n              <button class=\"site-footer__toggle\" type=\"button\" aria-expanded=\"false\">\n                <span>Informações</span>\n                <span class=\"site-footer__chevron\" aria-hidden=\"true\"></span>\n              </button>\n              <div class=\"site-footer__stack site-footer__panel\">\n                <a href=\"mailto:vitoriavieira_vic@hotmail.com\">vitoriavieira_vic@hotmail.com</a>\n                <a href=\"https://wa.me/5511915023134?text=Ol%C3%A1%2C%20vim%20do%20site%20e%20gostaria%20de%20efetuar%20um%20agendamento.\" data-whatsapp-link>Fale comigo no WhatsApp</a>\n                <p>Rua Alm. Brasil, 685 - Mooca, São Paulo</p>\n                <p>CEP 03162-010</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </footer>\n    </main>";
