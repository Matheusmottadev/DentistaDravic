text=Ol%C3%A1%2C%20vim%20do%20site%20e%20gostaria%20de%20efetuar%20um%20agendamento.\" data-whatsapp-link>Fale comigo no WhatsApp</a>\n                <p>Rua Alm. Brasil, 685 - Mooca, São Paulo</p>\n                <p>CEP 03162-010</p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </footer>";
