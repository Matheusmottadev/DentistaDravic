      "type": 301
    },
    {
      "source": "/paginas/gengivoplastia",
      "destination": "/paginas/gengivoplastia.html",
      "type": 301
    },
    {
      "source": "/paginas/preenchimento-labial",
      "destination": "/paginas/preenchimento-labial.html",
      "type": 301
    },
    {
      "source": "/paginas/harmonizacao-facial",
